{
  "name": "aero-deploy",
  "version": "0.1.0",
  "description": "Local network APK distribution and version manager",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:web": "vite",
    "build": "npm run build:web && tsc -p tsconfig.build.json",
    "build:web": "vite build",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "test": "vitest run",
    "pretest": "npm run build:web",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate-cli.ts up",
    "migrate:down": "tsx --env-file-if-exists=.env src/db/migrate-cli.ts down",
    "upload": "tsx scripts/upload-apk.ts",
    "backfill:sha256": "tsx --env-file-if-exists=.env scripts/backfill-sha256.ts",
    "fonts": "node scripts/fetch-fonts.mjs"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.4",
    "@fastify/static": "^10.1.6",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
