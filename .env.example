HOST=0.0.0.0
PORT=3000

# Where uploaded APK files are stored, and the largest accepted upload
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=200

# Token for admin routes such as deleting a release. Leave empty to keep them disabled.
ADMIN_TOKEN=

# Used by docker compose to create the local PostgreSQL container
POSTGRES_USER=aerodeploy
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aerodeploy

DATABASE_URL=postgres://aerodeploy:change-me@localhost:5432/aerodeploy
# Integration tests drop and recreate the public schema of this database
TEST_DATABASE_URL=postgres://aerodeploy:change-me@localhost:5432/aerodeploy_test
